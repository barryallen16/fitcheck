{
  "expo": {
    "name": "FitCheck",
    "slug": "fitcheck",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo-placeholder-bk.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitcheck.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FitCheck needs access to your photos to analyze garments.",
        "NSCameraUsageDescription": "FitCheck uses camera to photograph garments.",
        "NSLocationWhenInUseUsageDescription": "FitCheck needs location for weather-based outfit suggestions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-placeholder-bk.png",
        "backgroundColor": "#0E0E0E"
      },
      "package": "com.fitcheck.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-location",
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "76427215-8684-4f0a-84cd-bb59f0252bdb"
      }
    },
    "owner": "barryalen16s-team"
  }
}
